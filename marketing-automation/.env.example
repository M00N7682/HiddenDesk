# ============================================
# HiddenDesk Marketing Automation - 환경변수
# 이 파일을 .env로 복사 후 값 입력
# ============================================

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password
REDDIT_USER_AGENT=HiddenDesk Marketing Bot v1.0

# Discord Webhooks (서버 설정 > 연동 > 웹후크)
DISCORD_WEBHOOK_WEBGAMES=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_INDIEGAMES=https://discord.com/api/webhooks/xxx/yyy

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHANNEL_ID=@hiddendesk_channel

# Twitter/X API (https://developer.twitter.com) - 유료
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret
